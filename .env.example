# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed app, used in WhatsApp links
NEXT_PUBLIC_APP_URL=https://hr.balasanka.in

# Login usernames are mapped to emails on this domain inside Supabase Auth
AUTH_EMAIL_DOMAIN=staff.balasanka-hr.local

# Google Sheet import / sync (only if you keep the Google Form)
GOOGLE_SHEET_NAME=Job Application All Locations
GOOGLE_SERVICE_ACCOUNT_JSON=
# Protects the /api/sync-sheet cron endpoint
CRON_SECRET=
# The admin account the sync and import sign in as (created by seed:users). No service-role key is used.
SYNC_USERNAME=sheet-sync
SYNC_PASSWORD=
