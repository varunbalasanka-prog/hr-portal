# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed app, used in WhatsApp links
NEXT_PUBLIC_APP_URL=https://hr.balasanka.in

# Login usernames are mapped to emails on this domain inside Supabase Auth
AUTH_EMAIL_DOMAIN=staff.balasanka-hr.local

# Google Sheet import / sync (only if you keep the Google Form)
GOOGLE_SHEET_NAME=Job Application All Locations
GOOGLE_SERVICE_ACCOUNT_JSON=
# Protects the cron endpoints (/api/cleanup nightly, /api/sync-sheet)
CRON_SECRET=
# The admin account the sync and import sign in as (created by seed:users). No service-role key is used.
SYNC_USERNAME=sheet-sync
SYNC_PASSWORD=

# Server-only secret for the /apply page. Its SHA-256 is stored in private.settings by migration 0013,
# so the public key alone can't submit applications. Generate: openssl rand -hex 32
APPLY_SECRET=

# Cloudflare Turnstile "I am human" check on /apply (free; optional: leave both blank to switch it off)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Phone push notifications (optional). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=

# WhatsApp Business Cloud API (optional; without it the WhatsApp buttons open wa.me with the message filled in)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# An approved UTILITY template with one body variable {{1}}
WHATSAPP_TEMPLATE=hr_message
WHATSAPP_TEMPLATE_LANG=en

# DigiLocker partner (optional; the onboarding form shows "Get from DigiLocker" once set)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://hr.balasanka.in/api/digilocker/callback
